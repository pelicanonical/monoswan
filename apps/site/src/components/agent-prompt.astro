---
interface Props {
	prompt: string;
}

const { prompt } = Astro.props;
---

<agent-prompt
	class="not-content flex flex-col gap-4 rounded-xl border border-(--sl-color-gray-5) bg-(--sl-color-bg) p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between"
>
	<div class="flex min-w-0 items-center gap-3">
		<span
			class="grid size-9 shrink-0 place-items-center rounded-lg bg-(--sl-color-accent-low) text-base text-(--sl-color-accent-high)"
			aria-hidden="true">✦</span
		>
		<div class="min-w-0">
			<strong class="block leading-tight"
				>Quick start with an agent</strong
			>
			<span class="mt-0.5 block text-sm text-(--sl-color-gray-2)">
				Give your agent the context it needs to configure monoswan
				quickly.
			</span>
		</div>
	</div>

	<button
		class="inline-flex &&:mt-0 w-full shrink-0 cursor-pointer items-center justify-center gap-2 rounded-lg border border-(--sl-color-gray-5) bg-(--sl-color-bg-nav) px-3 py-2 text-sm font-medium text-(--sl-color-text) shadow-sm transition-colors hover:border-(--sl-color-accent) hover:bg-(--sl-color-accent-low) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--sl-color-accent-high) sm:w-auto"
		type="button"
		data-copy-prompt
	>
		<svg
			class="size-4"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<rect width="14" height="14" x="8" y="8" rx="2"></rect>
			<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
			></path>
		</svg>
		<span data-copy-label>Copy prompt</span>
	</button>
	<span hidden data-prompt>{prompt}</span>
	<span class="sr-only" role="status" aria-live="polite" data-copy-status
	></span>
</agent-prompt>

<script>
	class AgentPrompt extends HTMLElement {
		connectedCallback() {
			const button =
				this.querySelector<HTMLButtonElement>("[data-copy-prompt]");
			const label = this.querySelector<HTMLElement>("[data-copy-label]");
			const prompt = this.querySelector<HTMLElement>("[data-prompt]");
			const status =
				this.querySelector<HTMLElement>("[data-copy-status]");

			button?.addEventListener("click", async () => {
				if (!label || !prompt || !status) return;

				try {
					await navigator.clipboard.writeText(
						prompt.textContent ?? "",
					);
					label.textContent = "Copied";
					status.textContent = "Prompt copied to clipboard";
				} catch {
					label.textContent = "Copy failed";
					status.textContent = "Could not copy prompt to clipboard";
				}

				globalThis.window.setTimeout(() => {
					label.textContent = "Copy prompt";
					status.textContent = "";
				}, 2000);
			});
		}
	}

	customElements.define("agent-prompt", AgentPrompt);
</script>
