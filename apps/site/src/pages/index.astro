---
import monoswan from "../assets/monoswan.png";
import "../styles/global.css";
import { Font } from "astro:assets";
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <title>monoswan — pleasant monorepos</title>
  <meta
    name="description"
    content="Keep package configuration consistent across a monorepo."
  />
  <meta property="og:title" content="monoswan — pleasant monorepos" />
  <meta
    property="og:description"
    content="Keep package configuration consistent across a monorepo."
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://monoswan.com/" />
  <meta name="twitter:card" content="summary" />
  <link rel="canonical" href="https://monoswan.com/" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <Font cssVariable="--font-forum" />
  <Font cssVariable="--font-departure-mono" />
</head>

<main
  class="flex text-white flex-col font-forum gap-3 justify-center min-h-screen place-items-center bg-[#111111] p-4"
>
  <img class="w-full max-w-80" src={monoswan.src} alt="monoswan" />

  <div class="text-xl max-w-125 text-center">
    monoswan enforces config consistency, creates packages from templates, and
    helps you manage any monorepo
  </div>

  <div
    class="flex max-w-md items-center gap-3 rounded-xl border border-white/10 bg-white/4 p-1 pl-4 text-white shadow-lg shadow-black/10"
  >
    <code class="flex-1 overflow-x-auto whitespace-nowrap text-sm text-white/80"
      >pnpm add monoswan -D -w</code
    >
    <button
      class="grid size-6 shrink-0 place-items-center rounded-lg border-0 bg-transparent text-lg leading-none text-white/60 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/60"
      type="button"
      data-copy-button
      aria-label="Copy install command"
      title="Copy install command"
      ><i class="ph ph-copy" aria-hidden="true"></i></button
    >
  </div>
  <nav class="flex flex-wrap justify-center gap-2" aria-label="monoswan links">
    <a
      class="inline-grid size-9 place-items-center rounded-lg border border-white/10 text-lg text-white/60 no-underline transition-colors hover:border-white/20 hover:bg-white/[0.04] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/60"
      href="/docs/"
      aria-label="Documentation"
      title="Documentation"
    >
      <i class="ph ph-book-open" aria-hidden="true"></i>
    </a>
    <a
      class="inline-grid size-9 place-items-center rounded-lg border border-white/10 text-lg text-white/60 no-underline transition-colors hover:border-white/20 hover:bg-white/[0.04] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/60"
      href="https://github.com/pelicanonical/monoswan"
      target="_blank"
      rel="noreferrer"
      aria-label="monoswan on GitHub"
      title="GitHub"
    >
      <i class="ph ph-github-logo" aria-hidden="true"></i>
    </a>
    <a
      class="inline-grid size-9 place-items-center rounded-lg border border-white/10 text-lg text-white/60 no-underline transition-colors hover:border-white/20 hover:bg-white/[0.04] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/60"
      href="https://www.npmx.dev/package/monoswan"
      target="_blank"
      rel="noreferrer"
      aria-label="monoswan on npmx"
      title="npmx"
    >
      <i class="ph ph-package" aria-hidden="true"></i>
    </a>
  </nav>
</main>

<script>
  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-button]");
  const copyIcon = copyButton?.querySelector<HTMLElement>("i");

  copyButton?.addEventListener("click", async () => {
    await navigator.clipboard.writeText("pnpm add monoswan -D -w");
    copyButton.ariaLabel = "Install command copied";
    copyButton.title = "Copied!";
    copyIcon?.classList.replace("ph-copy", "ph-check");

    globalThis.window.setTimeout(() => {
      copyButton.ariaLabel = "Copy install command";
      copyButton.title = "Copy install command";
      copyIcon?.classList.replace("ph-check", "ph-copy");
    }, 1500);
  });
</script>
