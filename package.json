{
  "name": "monoswan-repo",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "scripts": {
    "build": "pnpm clean:dists && turbo run build",
    "check": "turbo run check",
    "clean:dists": "rimraf -g \"**/dist\"",
    "dev": "turbo watch dev:vite-app dev:build dev:start --ui=tui",
    "dev:build": "turbo run dev:build",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "monoswan": "./packages/system/monoswan/dist/cli.mjs",
    "monoswan:lint": "./packages/system/monoswan/dist/cli.mjs lint .",
    "preinstall": "only-allow pnpm",
    "prepare": "husky",
    "publint": "pnpm -r exec publint",
    "start": "turbo run start --ui=tui",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@yarnpkg/cli-dist": "4.18.1",
    "dedent": "^1.7.2",
    "husky": "^9.1.7",
    "only-allow": "^1.2.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.6.0",
      "onFail": "error"
    }
  }
}
